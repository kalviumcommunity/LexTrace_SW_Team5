{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeBaseDocument",
  "description": "Schema definition for internal RAG knowledge base documents",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the document"
    },
    "title": {
      "type": "string",
      "description": "Document title or subject headline"
    },
    "content": {
      "type": "string",
      "description": "Full document body text used for vector embedding"
    }
  },
  "required": ["id", "title", "content"]
}
